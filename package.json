{
  "name": "lab1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "个人 Lab1：面向对象的 SVG 命令行编辑器",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "demo": "tsx src/main.ts < examples/creation.txt",
    "demo:svg": "node -e \"require('node:fs').mkdirSync('output',{recursive:true})\" && tsx src/main.ts < examples/export.txt",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
